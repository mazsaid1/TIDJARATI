# ─────────────────────────────────────────────────────────────────────────────
# TIDJARATI — configuration
#
# The app runs in DEMO MODE with zero keys: `npm run dev` works immediately.
# Add keys progressively to flip each capability on (see src/lib/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — Clerk (https://dashboard.clerk.com)
# Without these, a local demo sign-in form is used instead.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Backend — Convex (https://dashboard.convex.cloud)
# Without this, the dashboard serves local mock data.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Billing — Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# AI — any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Email — Resend (https://resend.com)
RESEND_API_KEY=

# Analytics — PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
